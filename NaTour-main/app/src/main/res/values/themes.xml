<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.NaTour" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_home</item>
        <item name="colorPrimaryVariant">@color/green_home_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lightgrey</item>
        <item name="colorSecondaryVariant">@color/grey</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="MineCustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">7sp</item>
        <item name="singleLine">false</item>
        <item name="maxLines">2</item>
    </style>

    <style name="MineTabStyle" parent="Widget.Design.TabLayout">
        <item name="maxLines">2</item>
        <item name="singleLine">false</item>
        <item name="android:background">@color/green_home</item>
    </style>

    <style name="MyListTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">50dp</item>
        <item name="android:layout_marginBottom">-15dp</item>
        <item name="android:textSize">25dp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="MyListItem" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">25dp</item>
        <item name="android:textSize">15dp</item>
        <item name="maxLines">3</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Theme.NaTour.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.FirstPrototypeHome.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.FirstPrototypeHome.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="android:progressTint">@color/star</item>
        <item name="borderWidth">5dp</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:progressBackgroundTint">@color/grayBlue</item>
        <item name="android:secondaryProgressTint">@color/transparent</item>
    </style>

    <style name="SwitchStyleFilter" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/white</item>
    </style>

    <style name="SwitchStyle" parent="Theme.AppCompat.Light">
        <item name="colorControlActivated">@color/green_home_variant</item>
    </style>

    <style name="ButtonStyle" parent="TextAppearance.AppCompat.Button">
        <item name="backgroundTint">@color/green_home</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textIsSelectable">false</item>
        <item name="android:textStyle">normal</item>
        <item name="cornerRadius">25dp</item>
    </style>

    <style name="FloatingButtonStyle" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/darkish_green</item>
    </style>

    <style name="MyListViewStyle" parent="Widget.AppCompat.ListView">
        <item name="android:divider">@drawable/list_divider</item>
        <item name="android:dividerHeight">5px</item>
    </style>

    <style name="MyAppBarColor" parent="Widget.Design.AppBarLayout">
        <item name="backgroundTint">@color/green_home</item>
    </style>

    <style name="MyTextInputLayoutColor" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/outlined_green</item>
        <item name="boxStrokeWidth">2dp</item>
    </style>


</resources>